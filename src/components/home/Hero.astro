---
import { Image } from 'astro:assets';
import heroImg from '@/assets/me-hero.jpg';
import { socials } from '@/data/site';
import '@/styles/home/hero.css';

const words = ['Software Engineer', 'React Engineer', 'Node.js Developer', 'Mobile App Developer', 'Full-Stack Builder'];
---

<section class="mp-hero" id="hero">
  <div class="mp-hero__dots" aria-hidden="true"></div>

  <div class="mp-container">
    <div class="mp-hero__grid">
      <div class="mp-hero__content">
        <span class="mp-hero__badge mp-reveal">
          <span class="mp-dot"></span>
          Available for new projects
        </span>

        <h1 class="mp-hero__title mp-reveal mp-reveal--d1">
          Hi, I'm <span class="mp-accent">Naymul Hasan</span>
        </h1>

        <p class="mp-hero__subtitle mp-reveal mp-reveal--d2">
          I'm a <span class="mp-typed" data-words={JSON.stringify(words)}>{words[0]}</span>
        </p>

        <p class="mp-hero__description mp-reveal mp-reveal--d3">
          I build software end-to-end. React front-ends, Node.js APIs, cross-platform mobile apps, and AI-powered
          features — plus deep WordPress experience when it fits the brief. 8+ years turning ideas into products that
          actually ship.
        </p>

        <div class="mp-hero__ctas mp-reveal mp-reveal--d4">
          <a class="mp-btn mp-btn--primary" href="#get-in-touch">
            Let's Collaborate <i class="fa-solid fa-arrow-right" aria-hidden="true"></i>
          </a>
          <a class="mp-btn mp-btn--ghost" href="#projects">View Projects</a>
        </div>

        <div class="mp-hero__social mp-reveal mp-reveal--d5">
          {
            socials.map((s) => (
              <a href={s.href} aria-label={s.label} target={s.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                <i class={s.icon} aria-hidden="true" />
              </a>
            ))
          }
        </div>
      </div>

      <div class="mp-hero__visual mp-reveal mp-reveal--d2">
        <div class="mp-hero__blob" aria-hidden="true"></div>
        <div class="mp-hero__imgwrap">
          <Image src={heroImg} alt="Naymul Hasan" widths={[400, 640, 960]} sizes="(max-width: 900px) 90vw, 480px" loading="eager" fetchpriority="high" />
        </div>
        <div class="mp-hero__chip mp-hero__chip--tl"><i class="fa-brands fa-react" aria-hidden="true"></i> React</div>
        <div class="mp-hero__chip mp-hero__chip--tr"><i class="fa-brands fa-node-js" aria-hidden="true"></i> Node.js</div>
        <div class="mp-hero__chip mp-hero__chip--bl"><i class="fa-solid fa-mobile-screen-button" aria-hidden="true"></i> Mobile</div>
        <div class="mp-hero__chip mp-hero__chip--br"><i class="fa-solid fa-wand-magic-sparkles" aria-hidden="true"></i> AI</div>
      </div>
    </div>
  </div>
</section>
