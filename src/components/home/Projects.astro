---
import { projects } from '@/data/projects';
import '@/styles/home/projects.css';

// Two of the cards point at pages on this site (/wp-pond/, /lancer/) and one points
// off-site. Only the off-site one should open a new tab or claim to be an external link.
// The card title carries the link so the anchor text is the project name rather than
// three identical "View project" links.
const isExternal = (url: string) => /^https?:\/\//.test(url);
---

<section class="mp-projects" id="projects">
  <div class="mp-container">
    <div class="mp-section__head mp-reveal">
      <span class="mp-label">Selected Work</span>
      <h2 class="mp-section__title">Projects I've shipped</h2>
    </div>

    <div class="mp-projects__grid">
      {
        projects.map((p, i) => (
          <article class={`mp-project mp-reveal mp-reveal--d${i + 1}`}>
            <span class="mp-project__tag">{p.tag}</span>
            <h3>
              <a
                href={p.url}
                target={isExternal(p.url) ? '_blank' : undefined}
                rel={isExternal(p.url) ? 'noopener noreferrer' : undefined}
                class="mp-project__title-link"
              >
                {p.title}
                {isExternal(p.url) && <span class="sr-only"> (opens in a new tab)</span>}
              </a>
            </h3>
            <p>{p.text}</p>
            <div class="mp-project__meta">
              <span>
                <i class="fa-regular fa-calendar" aria-hidden="true" /> {p.date}
              </span>
            </div>
            {/* Decoration, not a link: the title above is the card's single link and
                its ::after covers the whole card, so this line is already clickable. */}
            <span class="mp-project__link" aria-hidden="true">
              View project
              <i class={isExternal(p.url) ? 'fa-solid fa-arrow-up-right-from-square' : 'fa-solid fa-arrow-right'} />
            </span>
          </article>
        ))
      }
    </div>
  </div>
</section>
