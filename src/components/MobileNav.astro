---
import { nav } from '@/data/site';
---

<button class="nt-burger" type="button" aria-label="Open menu" aria-controls="nt-drawer" aria-expanded="false" data-menu-open>
  <i class="fa-solid fa-bars" aria-hidden="true"></i>
</button>

<div class="nt-drawer" id="nt-drawer" hidden data-drawer>
  <button class="nt-drawer__close" type="button" aria-label="Close menu" data-menu-close>
    <i class="fa-solid fa-xmark" aria-hidden="true"></i>
  </button>
  <nav aria-label="Mobile">
    <ul>
      {nav.map((item) => <li><a href={item.href} data-menu-link>{item.label}</a></li>)}
    </ul>
  </nav>
  <a class="nt-drawer__cta" href="/#get-in-touch" data-menu-link>
    Let's talk <i class="fa-solid fa-arrow-right-long" aria-hidden="true"></i>
  </a>
</div>

<script>
  const openBtn = document.querySelector<HTMLButtonElement>('[data-menu-open]');
  const drawer = document.querySelector<HTMLElement>('[data-drawer]');
  const closeBtn = document.querySelector<HTMLButtonElement>('[data-menu-close]');

  function setOpen(open: boolean) {
    if (!drawer || !openBtn) return;
    drawer.hidden = !open;
    openBtn.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) closeBtn?.focus();
    else openBtn.focus();
  }

  openBtn?.addEventListener('click', () => setOpen(true));
  closeBtn?.addEventListener('click', () => setOpen(false));
  drawer?.querySelectorAll('[data-menu-link]').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && drawer && !drawer.hidden) setOpen(false);
  });
</script>

<style>
  .nt-burger {
    display: none;
    width: 42px;
    height: 42px;
    align-items: center;
    justify-content: center;
    background: var(--mp-accent);
    color: #0B0B0F;
    border: 0;
    border-radius: 10px;
    font-size: 16px;
    cursor: pointer;
  }
  @media (max-width: 767px) {
    .nt-burger {
      display: inline-flex;
    }
  }
  .nt-drawer {
    position: fixed;
    inset: 0;
    z-index: 200;
    padding: 80px 24px 32px;
    background: rgba(11, 11, 15, 0.96);
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    animation: nt-fade 0.2s ease;
  }
  .nt-drawer[hidden] {
    display: none;
  }
  .nt-drawer__close {
    position: absolute;
    top: 20px;
    right: 16px;
    width: 42px;
    height: 42px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
    border: 0;
    border-radius: 10px;
    font-size: 18px;
    cursor: pointer;
  }
  .nt-drawer ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .nt-drawer ul a {
    display: block;
    padding: 14px 18px;
    color: #F1F5F9;
    font-size: 18px;
    border-radius: 10px;
    text-decoration: none;
  }
  .nt-drawer ul a:hover {
    background: rgba(255, 255, 255, 0.08);
  }
  .nt-drawer__cta {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 20px;
    padding: 12px 20px;
    background: var(--mp-accent);
    color: #0B0B0F;
    font-weight: 600;
    border-radius: 10px;
    text-decoration: none;
  }
  @keyframes nt-fade {
    from { opacity: 0; }
    to { opacity: 1; }
  }
</style>
