---
import { Image } from 'astro:assets';
import { excerptOf, formatDate, readingMinutes, type Post } from '@/lib/posts';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { title, cover, category, publishedDate } = post.data;
---

<article class="nt-post-card">
  <a class="nt-post-card__link" href={`/${post.id}/`} aria-label={title}>
    <div class="nt-post-card__media">
      {
        cover ? (
          <Image src={cover} alt="" widths={[400, 720]} sizes="(max-width: 640px) 100vw, 380px" />
        ) : (
          <div class="nt-post-card__placeholder" aria-hidden="true">
            <i class="fa-regular fa-image" />
          </div>
        )
      }
    </div>

    <div class="nt-post-card__body">
      {category && <span class="nt-post-card__cat">{category}</span>}
      <h2 class="nt-post-card__title">{title}</h2>
      <p class="nt-post-card__excerpt">{excerptOf(post)}</p>
      <div class="nt-post-card__meta">
        <span><i class="fa-regular fa-calendar" aria-hidden="true"></i> {formatDate(publishedDate)}</span>
        <span><i class="fa-regular fa-clock" aria-hidden="true"></i> {readingMinutes(post)} min</span>
      </div>
      <span class="nt-post-card__more">Read article <i class="fa-solid fa-arrow-right" aria-hidden="true"></i></span>
    </div>
  </a>
</article>
