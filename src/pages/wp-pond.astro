---
import BaseLayout from '@/layouts/BaseLayout.astro';
import '@/styles/home/base.css';

const uploads = '/wp-content/uploads';

const features = [
  {
    icon: 'fa-solid fa-layer-group',
    title: 'Pick your stack per site',
    text: 'PHP 5.6 through 8.5, MariaDB or MySQL, nginx or Apache. Every choice is per site and changeable on a site you already built.',
  },
  {
    icon: 'fa-solid fa-lock',
    title: 'Real HTTPS, real hostnames',
    text: 'An nginx reverse proxy on 80 and 443 with a locally trusted CA, so every site gets its own name and a padlock your browser accepts.',
  },
  {
    icon: 'fa-solid fa-screwdriver-wrench',
    title: 'Built for day-to-day work',
    text: 'Clone a site, export and import it, save it as a blueprint, log straight into wp-admin, toggle Xdebug, open Adminer, and catch outgoing mail in Mailpit.',
  },
];

const stack = ['PHP 5.6 → 8.5', 'Any WordPress', 'MariaDB', 'MySQL', 'nginx', 'Apache', 'Xdebug', 'Adminer', 'Mailpit'];

const downloads = [
  {
    os: 'windows',
    icon: 'fa-brands fa-windows',
    title: 'Windows 64-bit',
    meta: 'Windows 10 and 11 · x64 · Installer · 3.8 MB',
    file: 'wp-pond-0.1.0-setup-x64.exe',
    href: '/downloads/wp-pond-0.1.0-setup-x64.exe',
    alt: { label: 'portable .zip · 5.2 MB', href: `${uploads}/2026/09/wp-pond-0.1.0-windows-x64.zip` },
  },
  {
    os: 'windows32',
    icon: 'fa-brands fa-windows',
    title: 'Windows 32-bit',
    meta: 'Windows 10 and 11 · x86 · Installer · 3.8 MB',
    file: 'wp-pond-0.1.0-setup-x86.exe',
    href: '/downloads/wp-pond-0.1.0-setup-x86.exe',
    alt: { label: 'portable .zip · 5.1 MB', href: `${uploads}/2026/09/wp-pond-0.1.0-windows-x86.zip` },
  },
  {
    os: 'linux',
    icon: 'fa-brands fa-ubuntu',
    title: 'Ubuntu / Debian',
    meta: '16.04 and newer · x86_64 · .deb · 4.9 MB',
    file: 'wp-pond_0.1.0_amd64.deb',
    href: `${uploads}/2026/10/wp-pond_0.1.0_amd64.deb`,
  },
];

const sites = [
  { name: 'shop.test', php: 'PHP 8.3', db: 'MariaDB', on: true },
  { name: 'client-legacy.test', php: 'PHP 7.4', db: 'MySQL', on: true },
  { name: 'plugin-dev.test', php: 'PHP 8.5', db: 'MariaDB', on: false },
];
---

<BaseLayout
  title="WP Pond — Local WordPress development"
  description="Spin up a real WordPress site on your own machine in a couple of clicks. Any PHP from 5.6 to 8.5, any WordPress release, MariaDB or MySQL, nginx or Apache."
  section="page"
>
  <div class="pond">
    <!-- HERO -->
    <section class="pond-hero">
      <div class="pond-hero__glow" aria-hidden="true"></div>
      <div class="pond-hero__grid" aria-hidden="true"></div>

      <div class="mp-container pond-hero__layout">
        <div class="pond-hero__copy">
          <span class="pond-pill pond-in">
            <span class="pond-pill__dot"></span>
            Local WordPress development · v0.1.0
          </span>
          <h1 class="pond-hero__title pond-in pond-in--1">
            WP <span class="pond-gradient">Pond</span>
          </h1>
          <p class="pond-hero__lede pond-in pond-in--2">
            Spin up a real WordPress site on your own machine in a couple of clicks. Any PHP from 5.6 to 8.5, any
            WordPress release, MariaDB or MySQL, nginx or Apache — chosen per site, changed whenever you like, downloaded
            on demand.
          </p>
          <div class="pond-hero__ctas pond-in pond-in--3">
            <a class="pond-btn pond-btn--primary" href="#downloads" data-os-cta="windows">
              <i class="fa-brands fa-windows" aria-hidden="true"></i> Download for Windows
            </a>
            <a class="pond-btn pond-btn--ghost" href="#downloads" data-os-cta="linux">
              <i class="fa-brands fa-ubuntu" aria-hidden="true"></i> Download for Ubuntu / Debian
            </a>
          </div>
          <ul class="pond-hero__facts pond-in pond-in--4">
            <li><i class="fa-solid fa-code-branch" aria-hidden="true"></i> Free and open source</li>
            <li><i class="fa-solid fa-scale-balanced" aria-hidden="true"></i> MIT licensed</li>
            <li><i class="fa-solid fa-user-slash" aria-hidden="true"></i> No account, no sign-up</li>
          </ul>
        </div>

        <!-- App mock -->
        <div class="pond-app pond-in pond-in--2" aria-hidden="true">
          <div class="pond-app__bar">
            <span></span><span></span><span></span>
            <em>WP Pond</em>
          </div>
          <div class="pond-app__body">
            <div class="pond-app__head">
              <strong>Your sites</strong>
              <span class="pond-app__new"><i class="fa-solid fa-plus"></i> New site</span>
            </div>
            {
              sites.map((s) => (
                <div class="pond-app__row">
                  <span class:list={['pond-app__status', { 'is-on': s.on }]} />
                  <span class="pond-app__name">
                    <i class="fa-solid fa-lock" /> {s.name}
                  </span>
                  <span class="pond-app__tag">{s.php}</span>
                  <span class="pond-app__tag pond-app__tag--muted">{s.db}</span>
                </div>
              ))
            }
            <div class="pond-app__term">
              <span class="pond-app__prompt">$</span> creating <b>blog.test</b> · PHP 8.4 · nginx
              <span class="pond-app__ok"><i class="fa-solid fa-check"></i> ready in 9s</span>
            </div>
          </div>
          <div class="pond-app__float pond-app__float--a"><i class="fa-brands fa-wordpress"></i> WordPress 6.x</div>
          <div class="pond-app__float pond-app__float--b"><i class="fa-solid fa-shield-halved"></i> Trusted HTTPS</div>
        </div>
      </div>

      <div class="pond-marquee" aria-label="Supported stack">
        <div class="pond-marquee__track">
          {[...stack, ...stack].map((s) => <span class="pond-chip">{s}</span>)}
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="pond-section">
      <div class="mp-container">
        <div class="pond-head pond-reveal">
          <span class="mp-label">Why WP Pond</span>
          <h2 class="mp-section__title">Everything the site needs, bundled</h2>
          <p>No system packages to install, no services to register, nothing left behind on your machine.</p>
        </div>
        <div class="pond-features">
          {
            features.map((f, i) => (
              <article class="pond-feature pond-reveal" style={`--d:${i * 90}ms`}>
                <div class="pond-feature__icon">
                  <i class={f.icon} aria-hidden="true" />
                </div>
                <h3>{f.title}</h3>
                <p>{f.text}</p>
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- DOWNLOADS -->
    <section class="pond-section pond-section--alt" id="downloads">
      <div class="mp-container">
        <div class="pond-head pond-reveal">
          <span class="mp-label">Download</span>
          <h2 class="mp-section__title">Download WP Pond</h2>
          <p>Version 0.1.0 · Pick the build that matches your machine.</p>
        </div>
        <div class="pond-downloads">
          {
            downloads.map((d, i) => (
              <article class="pond-dl pond-reveal" data-os={d.os} style={`--d:${i * 90}ms`}>
                <span class="pond-dl__badge">Recommended for you</span>
                <div class="pond-dl__icon">
                  <i class={d.icon} aria-hidden="true" />
                </div>
                <h3>{d.title}</h3>
                <p>{d.meta}</p>
                <a class="pond-btn pond-btn--primary pond-btn--block" href={d.href} download>
                  <i class="fa-solid fa-download" aria-hidden="true" /> Download
                </a>
                <code class="pond-dl__file">{d.file}</code>
                {
                  d.alt ? (
                    <a class="pond-dl__alt" href={d.alt.href} download>
                      or get the {d.alt.label}
                    </a>
                  ) : (
                    <span class="pond-dl__alt" aria-hidden="true">&nbsp;</span>
                  )
                }
              </article>
            ))
          }
        </div>
      </div>
    </section>

    <!-- NOTICE -->
    <section class="pond-section pond-section--tight">
      <div class="mp-container">
        <div class="pond-notice pond-reveal">
          <div class="pond-notice__icon"><i class="fa-solid fa-flask" aria-hidden="true"></i></div>
          <div>
            <h3>Early days — worth knowing before you install</h3>
            <p>
              This is version 0.1.0. The Linux build has been run end to end on a real machine; the Windows build has not
              been exercised yet. Apache is Linux-only for now, and macOS is not supported at all. If something breaks,
              please open an issue — that is exactly what this stage is for.
            </p>
          </div>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>

<script>
  // Highlight the download that matches the visitor's OS and point the hero buttons at it.
  const ua = navigator.userAgent.toLowerCase();
  const os = ua.includes('windows') ? (/win64|x64|wow64/.test(ua) ? 'windows' : 'windows32') : ua.includes('linux') && !ua.includes('android') ? 'linux' : null;
  if (os) document.querySelector(`.pond-dl[data-os="${os}"]`)?.classList.add('is-recommended');

  // Fade cards in as they scroll into view.
  const items = document.querySelectorAll('.pond-reveal');
  if ('IntersectionObserver' in window) {
    document.documentElement.classList.add('pond-js');
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (!e.isIntersecting) continue;
          e.target.classList.add('is-visible');
          io.unobserve(e.target);
        }
      },
      { threshold: 0.15 },
    );
    items.forEach((el) => io.observe(el));
  }
</script>

<style>
  .pond {
    --teal: #2dd4bf;
    --teal-2: #5eead4;
    --teal-soft: rgba(45, 212, 191, 0.12);
    overflow-x: clip;
  }

  /* ---------- Hero ---------- */
  .pond-hero {
    position: relative;
    padding: 96px 0 0;
    overflow: hidden;
    isolation: isolate;
  }
  .pond-hero__glow {
    position: absolute;
    inset: -20% -10% auto;
    height: 760px;
    z-index: -2;
    background:
      radial-gradient(40% 50% at 25% 30%, rgba(45, 212, 191, 0.22), transparent 70%),
      radial-gradient(35% 45% at 80% 20%, rgba(52, 211, 153, 0.16), transparent 70%),
      radial-gradient(30% 40% at 60% 80%, rgba(14, 116, 144, 0.25), transparent 70%);
    filter: blur(10px);
    animation: pond-drift 18s ease-in-out infinite alternate;
  }
  .pond-hero__grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgba(255, 255, 255, 0.04) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255, 255, 255, 0.04) 1px, transparent 1px);
    background-size: 56px 56px;
    mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
    -webkit-mask-image: radial-gradient(ellipse 70% 60% at 50% 30%, #000 30%, transparent 75%);
  }
  @keyframes pond-drift {
    to {
      transform: translate3d(3%, 4%, 0) scale(1.05);
    }
  }

  .pond-hero__layout {
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    gap: 56px;
    align-items: center;
  }

  .pond-pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 7px 14px;
    font-size: 13px;
    font-weight: 600;
    color: var(--teal-2);
    background: var(--teal-soft);
    border: 1px solid rgba(45, 212, 191, 0.3);
    border-radius: 999px;
  }
  .pond-pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--teal);
    box-shadow: 0 0 0 0 rgba(45, 212, 191, 0.6);
    animation: pond-ping 2s infinite;
  }
  @keyframes pond-ping {
    70% {
      box-shadow: 0 0 0 9px rgba(45, 212, 191, 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgba(45, 212, 191, 0);
    }
  }

  .pond-hero__title {
    margin: 22px 0 18px;
    font-size: clamp(52px, 8vw, 92px);
    line-height: 0.95;
    font-weight: 900;
    letter-spacing: -0.045em;
  }
  .pond-gradient {
    background: linear-gradient(110deg, #5eead4 0%, #34d399 40%, #a7f3d0 60%, #2dd4bf 100%);
    background-size: 200% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    animation: pond-shine 6s linear infinite;
  }
  @keyframes pond-shine {
    to {
      background-position: 200% center;
    }
  }
  .pond-hero__lede {
    max-width: 560px;
    margin: 0 0 32px;
    color: var(--mp-muted);
    font-size: 18px;
    line-height: 1.7;
  }
  .pond-hero__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .pond-hero__facts {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 22px;
    margin: 28px 0 0;
    padding: 0;
    list-style: none;
    color: var(--mp-subtle);
    font-size: 14px;
  }
  .pond-hero__facts i {
    color: var(--teal);
    margin-right: 6px;
  }

  /* ---------- Buttons ---------- */
  .pond-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 15px 24px;
    border-radius: 12px;
    font-size: 15px;
    font-weight: 700;
    line-height: 1;
    text-decoration: none;
    border: 1px solid transparent;
    transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease, border-color 0.2s ease;
  }
  .pond-btn--primary {
    color: #042f2e;
    background: linear-gradient(135deg, #5eead4, #2dd4bf 50%, #34d399);
    box-shadow: 0 10px 30px -10px rgba(45, 212, 191, 0.65), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .pond-btn--primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -10px rgba(45, 212, 191, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.35);
  }
  .pond-btn--ghost {
    color: var(--mp-fg);
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--mp-border-strong);
    backdrop-filter: blur(8px);
  }
  .pond-btn--ghost:hover {
    border-color: rgba(45, 212, 191, 0.55);
    background: var(--teal-soft);
    transform: translateY(-2px);
  }
  .pond-btn--block {
    width: 100%;
  }

  /* ---------- App mock ---------- */
  .pond-app {
    position: relative;
    border-radius: 18px;
    background: linear-gradient(180deg, rgba(24, 24, 27, 0.92), rgba(17, 17, 22, 0.92));
    border: 1px solid var(--mp-border-strong);
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.8),
      0 0 0 1px rgba(45, 212, 191, 0.08),
      0 30px 90px -40px rgba(45, 212, 191, 0.45);
    transform: perspective(1400px) rotateY(-8deg) rotateX(4deg);
    transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .pond-app:hover {
    transform: perspective(1400px) rotateY(0deg) rotateX(0deg);
  }
  .pond-app__bar {
    display: flex;
    align-items: center;
    gap: 7px;
    padding: 14px 16px;
    border-bottom: 1px solid var(--mp-border);
  }
  .pond-app__bar span {
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: #3f3f46;
  }
  .pond-app__bar span:nth-child(1) {
    background: #f87171;
  }
  .pond-app__bar span:nth-child(2) {
    background: #fbbf24;
  }
  .pond-app__bar span:nth-child(3) {
    background: #34d399;
  }
  .pond-app__bar em {
    margin-left: auto;
    font-style: normal;
    font-size: 12px;
    color: var(--mp-subtle);
  }
  .pond-app__body {
    padding: 18px;
    display: grid;
    gap: 10px;
  }
  .pond-app__head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 4px;
    font-size: 14px;
  }
  .pond-app__new {
    font-size: 12px;
    font-weight: 600;
    color: #042f2e;
    background: var(--teal);
    padding: 6px 10px;
    border-radius: 8px;
  }
  .pond-app__row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 14px;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid var(--mp-border);
    border-radius: 12px;
    font-size: 13.5px;
  }
  .pond-app__status {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #52525b;
    flex-shrink: 0;
  }
  .pond-app__status.is-on {
    background: #34d399;
    box-shadow: 0 0 10px rgba(52, 211, 153, 0.8);
  }
  .pond-app__name {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .pond-app__name i {
    color: var(--teal);
    font-size: 11px;
    margin-right: 4px;
  }
  .pond-app__tag {
    font-size: 11.5px;
    padding: 3px 8px;
    border-radius: 6px;
    color: var(--teal-2);
    background: var(--teal-soft);
    white-space: nowrap;
  }
  .pond-app__tag--muted {
    color: var(--mp-muted);
    background: rgba(255, 255, 255, 0.05);
  }
  .pond-app__term {
    margin-top: 4px;
    padding: 12px 14px;
    border-radius: 12px;
    background: #050507;
    border: 1px solid var(--mp-border);
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 12.5px;
    color: var(--mp-muted);
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }
  .pond-app__term b {
    color: var(--mp-fg);
    font-weight: 600;
  }
  .pond-app__prompt {
    color: var(--teal);
  }
  .pond-app__ok {
    margin-left: auto;
    color: #34d399;
  }
  .pond-app__float {
    position: absolute;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 10px 14px;
    font-size: 13px;
    font-weight: 600;
    background: rgba(24, 24, 27, 0.9);
    border: 1px solid var(--mp-border-strong);
    border-radius: 12px;
    box-shadow: var(--mp-shadow-md);
    backdrop-filter: blur(10px);
    animation: pond-float 5s ease-in-out infinite;
  }
  .pond-app__float i {
    color: var(--teal);
  }
  .pond-app__float--a {
    top: -18px;
    right: 28px;
  }
  .pond-app__float--b {
    bottom: -20px;
    left: -18px;
    animation-delay: -2.5s;
  }
  @keyframes pond-float {
    50% {
      transform: translateY(-8px);
    }
  }

  /* ---------- Stack marquee ---------- */
  .pond-marquee {
    margin-top: 88px;
    padding: 22px 0;
    border-block: 1px solid var(--mp-border);
    background: rgba(255, 255, 255, 0.015);
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .pond-marquee__track {
    display: flex;
    gap: 14px;
    width: max-content;
    animation: pond-marquee 30s linear infinite;
  }
  .pond-marquee:hover .pond-marquee__track {
    animation-play-state: paused;
  }
  @keyframes pond-marquee {
    to {
      transform: translateX(-50%);
    }
  }
  .pond-chip {
    padding: 9px 16px;
    font-size: 14px;
    font-weight: 600;
    color: var(--mp-muted);
    border: 1px solid var(--mp-border-strong);
    border-radius: 999px;
    white-space: nowrap;
  }

  /* ---------- Sections ---------- */
  .pond-section {
    padding: 110px 0;
  }
  .pond-section--alt {
    background:
      radial-gradient(50% 60% at 50% 0%, rgba(45, 212, 191, 0.08), transparent 70%),
      var(--mp-alt);
    border-block: 1px solid var(--mp-border);
  }
  .pond-section--tight {
    padding: 80px 0 110px;
  }
  .pond-head {
    max-width: 640px;
    margin: 0 auto 56px;
    text-align: center;
  }
  .pond-head .mp-label {
    color: var(--teal-2);
    background: var(--teal-soft);
  }
  .pond-head p {
    margin: 0;
    color: var(--mp-muted);
    font-size: 17px;
  }

  /* ---------- Features ---------- */
  .pond-features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 22px;
  }
  .pond-feature {
    position: relative;
    padding: 32px 28px;
    border-radius: 18px;
    background: linear-gradient(180deg, var(--mp-card), rgba(24, 24, 27, 0.5));
    border: 1px solid var(--mp-border);
    transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  }
  .pond-feature::before {
    content: '';
    position: absolute;
    inset: 0 30% auto;
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--teal), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .pond-feature:hover {
    transform: translateY(-6px);
    border-color: rgba(45, 212, 191, 0.35);
    box-shadow: 0 24px 50px -24px rgba(45, 212, 191, 0.35);
  }
  .pond-feature:hover::before {
    opacity: 1;
  }
  .pond-feature__icon {
    width: 52px;
    height: 52px;
    display: grid;
    place-items: center;
    margin-bottom: 22px;
    border-radius: 14px;
    font-size: 20px;
    color: var(--teal-2);
    background: linear-gradient(135deg, rgba(45, 212, 191, 0.22), rgba(45, 212, 191, 0.05));
    border: 1px solid rgba(45, 212, 191, 0.3);
  }
  .pond-feature h3 {
    margin: 0 0 10px;
    font-size: 19px;
    font-weight: 700;
  }
  .pond-feature p {
    margin: 0;
