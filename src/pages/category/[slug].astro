---
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/blog/PostList.astro';
import { getPosts, slugify, type Post } from '@/lib/posts';
import '@/styles/home/base.css';

export async function getStaticPaths() {
  const posts = await getPosts();
  const groups = new Map<string, { name: string; posts: Post[] }>();
  for (const post of posts) {
    const name = post.data.category || 'Uncategorized';
    const slug = slugify(name);
    if (!groups.has(slug)) groups.set(slug, { name, posts: [] });
    groups.get(slug)!.posts.push(post);
  }
  return [...groups].map(([slug, group]) => ({ params: { slug }, props: group }));
}

const { name, posts } = Astro.props;
---

<BaseLayout title={`Category: ${name}`} section="blog">
  <PostList eyebrow="Category" title={name} subtitle={`${posts.length} ${posts.length === 1 ? 'post' : 'posts'}`} posts={posts} />
</BaseLayout>
