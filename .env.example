# Needed only on the live site, so Keystatic can sign you in with GitHub and
# commit posts to this repo. Running /keystatic locally creates the GitHub App
# and writes these values to .env for you.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
# Build-time only (not secret). Must also be set wherever the site is built (CI).
PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
